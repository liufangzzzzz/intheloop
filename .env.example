# Public website address used for metadata and canonical links.
ITL_PUBLIC_ORIGIN=https://intheloop.geekpark.net

# Read-only content API provided by the operations repository.
# This service never receives the operations password or Modelink key.
INTHELOOP_CONTENT_API_ORIGIN=https://toolkit-intheloop.geekpark.net

# Local/container port.
ITL_PORT=3001
ITL_IMAGE_TAG=latest
